// =============================================================================
//  Бренд на друкованих деталях: знак у колі (+ слово) як виїмка 0.4 мм.
//
//  Місця, розміри й кути — НЕ тут, а в моделі (scad/excavator_boom.scad, розділ «ЛОГОТИП»,
//  таблиця brand_marks): звідти ж їх показують 3D-сторінки, рендери й аркуші розкладки,
//  тож надрукований знак стоїть рівно там, де його видно на сторінці. Полігони —
//  scad/brand/ (знак Ø18 і Ø12 у друкованих мм; штрихи й стінки між виїмками не тонші
//  за 0.8 мм — дві лінії сопла).
//
//  Виїмка вирізається в СИСТЕМІ ДЕТАЛІ, до укладання на стіл (lay() потім повертає все
//  разом), тому друкованих координат тут немає. Орієнтацію на столі див. parts.scad:
//  знак на трубах і плиті колони — на обох гранях (одна з них друкується на столі),
//  на боковинах ковша — на верхній, зовнішній.
//
//  Чому саме такі місця (числа — друковані мм, по STL набору):
//    - труба стріли, сегмент 1: між накладкою осі A (x ≤ 13) і щокою перелому (x ≥ 130) —
//      знак Ø18 зі словом (композиція 61 мм, x ≈ 19–81);
//    - труба рукояті: між щокою п'яти (x ≤ 84) і накладкою кінця (x ≥ 135.6) — знак Ø12
//      зі словом (композиція 42 мм; грань 20 мм завширшки, Ø18 не лишає полів, а Ø14 зі
//      словом упирається в накладки);
//    - плита колони: найширше місце профілю між отворами A і C (найбільше вільне коло Ø38
//      з центром (10.2, 46.1)) — знак Ø18;
//    - боковини ковша: знак Ø12 зі словом (Ø18 зі словом не влазить під жодним кутом),
//      центр — де до кромок найдалі (3.3 мм);
//    - сегмент 2 стріли — без бренду: між щокою перелому (до x = 60) і пластиною вилки B
//      (від x = 64) на бічній грані місця немає.
// =============================================================================
BRAND_DEPTH = 0.4;     // 2 шари по 0.2: читається тінню; стеля труби 1.0 лишає 0.6

// Деталь (children) без виїмок знаків key: глибина — BRAND_DEPTH друкованих мм,
// зріз виходить на 1 мм над поверхнею, щоб не лишилось плівки на площині грані.
module branded(key, side = 0) {
    difference() {
        children();
        brand_body(key, P(BRAND_DEPTH), P(1), side);
    }
}

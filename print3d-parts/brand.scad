// =============================================================================
//  Бренд на друкованих деталях: знак у колі (+ слово) як виїмка 0.4 мм.
//
//  Полігони знака й слова — готові файли в brand/ (`*-print-NNmm.scad`: знак Ø18 і Ø14
//  зі словом, знак Ø18 сам; штрихи й стінки між виїмками не тонші за 0.8 мм — дві лінії
//  сопла), обгортка лише вирізає їх. Виїмка робиться в КООРДИНАТАХ СТОЛУ вже після
//  укладання деталі (parts.scad → lay()), тому всі числа тут — друковані мм по STL набору;
//  модель і місця деталей у ній не чіпаються.
//
//  Куди стає бренд (і чому саме туди):
//    - труба стріли, сегмент 1: верхня грань між накладкою осі A (x ≤ 13) і щокою
//      перелому (x ≥ 130) — знак Ø18 зі словом (композиція 61 мм, x ≈ 19–81);
//    - труба рукояті: верхня грань між щокою п'яти (x ≤ 84) і накладкою кінця (x ≥ 135.6) —
//      знак Ø12 зі словом (композиція 42 мм; грань 20 мм завширшки, Ø18 не лишає полів,
//      а Ø14 зі словом упирається в накладки);
//    - плита колони: обидві грані, у найширшому місці профілю між отворами A і C
//      (найбільше вільне коло Ø38 з центром (10.2, 46.1)) — знак Ø18;
//    - сегмент 2 стріли — без бренду: між щокою перелому (до x = 60) і пластиною вилки B
//      (від x = 64) на верхній грані місця немає.
//  Межі накладних деталей отримані з моделі тим самим lay(), що й труби.
//
//  Орієнтація. Верх деталі в машині — це −Y столу (труби: tube_local має верх у +Z моделі,
//  lay() кладе +Z моделі в −Y столу; плита: вісь A вгорі, тобто y = 0, низ — y = 101).
//  Логотип має читатися нормально для того, хто дивиться на грань, з верхом машини вгору:
//    грань "top"    — глядач з +Z, верх −Y → його «праворуч» = −X: rotate 180°;
//    грань "bottom" — глядач з −Z, верх −Y → його «праворуч» = +X: дзеркало по y.
//  Тому на двох боках машини силует копає в різні боки, а слово читається з обох — як
//  наліпки на будь-якій техніці.
// =============================================================================
include <brand/ibitlab-logo-horizontal-print-18mm.scad>
include <brand/ibitlab-logo-horizontal-print-12mm.scad>
include <brand/ibitlab-logo-mark-print-18mm.scad>

BRAND_DEPTH = 0.4;     // 2 шари по 0.2: читається тінню; стеля труби 1.0 лишає 0.6

// [ключ деталі, грань, [x, y] центра КОМПОЗИЦІЇ на столі, що, Ø]
//   грань: "top" (z = +zf) або "bottom" (z = −zf); zf — половина висоти деталі на столі
//   що: "horizontal" — знак + слово, "mark" — лише знак
brand_marks = [
    ["tube_boom_seg1", "top",    [50,   0],    "horizontal", 18, boom_tube_w/2/SC],
    ["tube_stick",     "top",    [110,  0],    "horizontal", 12, stick_tube_w/2/SC],
    ["post_plate",     "top",    [10.2, 46.1], "mark",       18, 12/2/SC],
    ["post_plate",     "bottom", [10.2, 46.1], "mark",       18, 12/2/SC],
];

module brand_shape(what, D) {
    if      (what == "horizontal" && D == 18) logo_horizontal_18();
    else if (what == "horizontal" && D == 12) logo_horizontal_12();
    else if (what == "mark"       && D == 18) logo_mark_18();
    else echo(str("!!! бренд: немає полігонів для ", what, " Ø", D));
}
// габарит композиції у її власних координатах (центр знака = 0; слово праворуч)
function brand_bounds(what, D) =
    what == "mark" ? [-D/2, -D/2, D/2, D/2] :
    D == 18 ? logo_horizontal_18_bounds : logo_horizontal_12_bounds;

// Виїмка на грані: композиція центрується (за габаритом) у точці c, повертається за
// правилом орієнтації грані і врізається на BRAND_DEPTH від поверхні всередину.
module brand_cut(key) {
    for (m = brand_marks) if (m[0] == key) {
        face = m[1]; c = m[2]; what = m[3]; D = m[4]; zf = m[5];
        b = brand_bounds(what, D);
        mid = [(b[0] + b[2]) / 2, (b[1] + b[3]) / 2];
        if (face == "top")
            translate([c[0], c[1], zf - BRAND_DEPTH]) linear_extrude(BRAND_DEPTH + 1)
                rotate([0, 0, 180]) translate(-mid) brand_shape(what, D);
        else if (face == "bottom")
            translate([c[0], c[1], -zf - 1]) linear_extrude(BRAND_DEPTH + 1)
                mirror([0, 1, 0]) translate(-mid) brand_shape(what, D);
        else echo(str("!!! бренд: невідома грань ", face));
    }
}
